  "style": "short_video_no_punctuation",
  "max_chars_per_line": 18,
  "captions": [
    {
      "index": 1,
      "text": "1951年美国空军出了个难题怎么看一",
      "start": 0.0,
      "end": 5.29,
      "segment_index": 1
    },
    {
      "index": 2,
      "text": "堆体检数据自动判断一个飞行员适不适合",
      "start": 5.29,
      "end": 10.581,
      "segment_index": 1
    },
    {
      "index": 3,
      "text": "执行高危任务这叫分类",
      "start": 10.581,
      "end": 13.52,
      "segment_index": 1
    },
    {
      "index": 4,
      "text": "两个统计学家Fix和Hodges想了",
      "start": 13.82,
      "end": 17.745,
      "segment_index": 2
    },
    {
      "index": 5,
      "text": "个蠢到家的方法找到跟你最像的那个人看",
      "start": 17.745,
      "end": 21.669,
      "segment_index": 2
    },
    {
      "index": 6,
      "text": "他被划成什么类别直接抄他的答案",
      "start": 21.669,
      "end": 24.94,
      "segment_index": 2
    },
    {
      "index": 7,
      "text": "怎么定义最像用距离就是初中学的勾股定",
      "start": 25.24,
      "end": 31.295,
      "segment_index": 3
    },
    {
      "index": 8,
      "text": "理推广到更多维度距离小就是像距离大就",
      "start": 31.295,
      "end": 37.351,
      "segment_index": 3
    },
    {
      "index": 9,
      "text": "是不像",
      "start": 37.351,
      "end": 38.36,
      "segment_index": 3
    },
    {
      "index": 10,
      "text": "这份报告写完然后呢没人看没发表没引用",
      "start": 38.66,
      "end": 48.544,
      "segment_index": 4
    },
    {
      "index": 11,
      "text": "石沉大海",
      "start": 48.544,
      "end": 50.74,
      "segment_index": 4
    },
    {
      "index": 12,
      "text": "直到16年后1967年两个数学家Co",
      "start": 51.04,
      "end": 57.459,
      "segment_index": 5
    },
    {
      "index": 13,
      "text": "ver和Hart做了一件事他们证明了",
      "start": 57.459,
      "end": 63.877,
      "segment_index": 5
    },
    {
      "index": 14,
      "text": "这个蠢方法在数学上是靠谱的只看一个最",
      "start": 63.877,
      "end": 70.296,
      "segment_index": 5
    },
    {
      "index": 15,
      "text": "近邻误差最多是上帝视角的两倍用最笨的",
      "start": 70.296,
      "end": 76.715,
      "segment_index": 5
    },
    {
      "index": 16,
      "text": "方法精度只损失一倍这篇论文被引用一万",
      "start": 76.715,
      "end": 83.134,
      "segment_index": 5
    },
    {
      "index": 17,
      "text": "八千多次",
      "start": 83.134,
      "end": 84.56,
      "segment_index": 5
    },
    {
      "index": 18,
      "text": "所以KNNK近邻一句话考试不会做的题",
      "start": 84.86,
      "end": 95.9,
      "segment_index": 6
    },
    {
      "index": 19,
      "text": "看旁边K个同学写的啥哪个答案多就抄哪",
      "start": 95.9,
      "end": 106.94,
      "segment_index": 6
    },
    {
      "index": 20,
      "text": "个K就是你问几个人",
      "start": 106.94,
      "end": 112.46,
      "segment_index": 6
    },
    {
      "index": 21,
      "text": "可是K怎么选K等于1只问旁边一个人那",
      "start": 112.76,
      "end": 117.542,
      "segment_index": 7
    },
    {
      "index": 22,
      "text": "人要是学渣你就完了K等于100问全班",
      "start": 117.542,
      "end": 122.324,
      "segment_index": 7
    },
    {
      "index": 23,
      "text": "那你不如直接看全班最多人选的答案了",
      "start": 122.324,
      "end": 126.84,
      "segment_index": 7
    },
    {
      "index": 24,
      "text": "所以K太小容易被个别噪声带偏这叫过拟",
      "start": 127.14,
      "end": 133.822,
      "segment_index": 8
    },
    {
      "index": 25,
      "text": "合K太大就看不到局部规律了这叫欠拟合",
      "start": 133.822,
      "end": 140.503,
      "segment_index": 8
    },
    {
      "index": 26,
      "text": "怎么选让数据自己说话交叉验证",
      "start": 140.503,
      "end": 145.7,
      "segment_index": 8
    },
    {
      "index": 27,
      "text": "顺便说一句KNN训练的时候干了啥答啥",
      "start": 146.0,
      "end": 151.093,
      "segment_index": 9
    },
    {
      "index": 28,
      "text": "也没干它就把数据存着等你来问的时候才",
      "start": 151.093,
      "end": 156.185,
      "segment_index": 9
    },
    {
      "index": 29,
      "text": "开始翻所以叫惰性学习优点训练零点一秒",
      "start": 156.185,
      "end": 161.278,
      "segment_index": 9
    },
    {
      "index": 30,
      "text": "缺点预测可能要十分钟这是个伏笔后面会",
      "start": 161.278,
      "end": 166.371,
      "segment_index": 9
    },
    {
      "index": 31,
      "text": "讲为什么这是个大问题",
      "start": 166.371,
      "end": 169.2,
      "segment_index": 9
    },
    {
      "index": 32,
      "text": "KNN能工作的根基是一个朴素到不行的",
      "start": 169.5,
      "end": 175.827,
      "segment_index": 10
    },
    {
      "index": 33,
      "text": "信念长得像的东西标签也像你妈和你阿姨",
      "start": 175.827,
      "end": 182.155,
      "segment_index": 10
    },
    {
      "index": 34,
      "text": "长得像基因也接近这是物理世界的常识K",
      "start": 182.155,
      "end": 188.482,
      "segment_index": 10
    },
    {
      "index": 35,
      "text": "NN只不过把它变成了算法",
      "start": 188.482,
      "end": 192.7,
      "segment_index": 10
    },
    {
      "index": 36,
      "text": "但这有个致命前提你量像不像的尺子得准",
      "start": 193.0,
      "end": 199.618,
      "segment_index": 11
    },
    {
      "index": 37,
      "text": "如果尺子是歪的量出来最近的那个人其实",
      "start": 199.618,
      "end": 206.236,
      "segment_index": 11
    },
    {
      "index": 38,
      "text": "离你八丈远垃圾进垃圾出",
      "start": 206.236,
      "end": 210.28,
      "segment_index": 11
    },
    {
      "index": 39,
      "text": "还有一个前提数据得够多你在一个5个人",
      "start": 210.58,
      "end": 216.043,
      "segment_index": 12
    },
    {
      "index": 40,
      "text": "的公司里问旁边的人怎么看那不叫民意调",
      "start": 216.043,
      "end": 221.506,
      "segment_index": 12
    },
    {
      "index": 41,
      "text": "查那叫掷骰子KNN需要足够多的邻居才",
      "start": 221.506,
      "end": 226.969,
      "segment_index": 12
    },
    {
      "index": 42,
      "text": "能统计出可靠的结论",
      "start": 226.969,
      "end": 229.7,
      "segment_index": 12
    },
    {
      "index": 43,
      "text": "三条公理缺一不可局部连续距离管用数据",
      "start": 230.0,
      "end": 236.127,
      "segment_index": 13
    },
    {
      "index": 44,
      "text": "够多三个全满足KNN有CoverHa",
      "start": 236.127,
      "end": 242.254,
      "segment_index": 13
    },
    {
      "index": 45,
      "text": "rt定理保底任何一个不满足全崩",
      "start": 242.254,
      "end": 247.36,
      "segment_index": 13
    },
    {
      "index": 46,
      "text": "刚说了距离得准对吧好最最最常见的翻车",
      "start": 247.66,
      "end": 253.595,
      "segment_index": 14
    },
    {
      "index": 47,
      "text": "忘记归一化你一列数据是年收入一万块另",
      "start": 253.595,
      "end": 259.53,
      "segment_index": 14
    },
    {
      "index": 48,
      "text": "一列是评分零点五距离全被收入主导了评",
      "start": 259.53,
      "end": 265.465,
      "segment_index": 14
    },
    {
      "index": 49,
      "text": "分等于不存在KNN变成了只看收入的分",
      "start": 265.465,
      "end": 271.401,
      "segment_index": 14
    },
    {
      "index": 50,
      "text": "类器",
      "start": 271.401,
      "end": 272.06,
      "segment_index": 14
    },
    {
      "index": 51,
      "text": "还有一个更绝的数据维度一高比如文本特",
      "start": 272.36,
      "end": 277.805,
      "segment_index": 15
    },
    {
      "index": 52,
      "text": "征五千维高维空间里所有点的距离都差不",
      "start": 277.805,
      "end": 283.25,
      "segment_index": 15
    },
    {
      "index": 53,
      "text": "多最近邻这三个字本身就没意义了公理二",
      "start": 283.25,
      "end": 288.695,
      "segment_index": 15
    },
    {
      "index": 54,
      "text": "直接失效这叫维度灾难",
      "start": 288.695,
      "end": 291.72,
      "segment_index": 15
    },
    {
      "index": 55,
      "text": "怎么办降维PCA压到100维以下或者",
      "start": 292.02,
      "end": 301.68,
      "segment_index": 16
    },
    {
      "index": 56,
      "text": "换余弦距离量方向而不是量位置记住维度",
      "start": 301.68,
      "end": 311.34,
      "segment_index": 16
    },
    {
      "index": 57,
      "text": "大于50欧氏距离基本废了",
      "start": 311.34,
      "end": 317.78,
      "segment_index": 16
    },
    {
      "index": 58,
      "text": "故事还没完1975年一个叫Bentl",
      "start": 318.08,
      "end": 322.627,
      "segment_index": 17
    },
    {
      "index": 59,
      "text": "ey的人发明了KDTree把搜索从跟",
      "start": 322.627,
      "end": 327.175,
      "segment_index": 17
    },
    {
      "index": 60,
      "text": "每个人比一遍变成了二分查找低维数据从",
      "start": 327.175,
      "end": 331.722,
      "segment_index": 17
    },
    {
      "index": 61,
      "text": "此秒搜",
      "start": 331.722,
      "end": 332.48,
      "segment_index": 17
    },
    {
      "index": 62,
      "text": "然后维度灾难来了KDTree在高维也",
      "start": 332.78,
      "end": 339.771,
      "segment_index": 18
    },
    {
      "index": 63,
      "text": "废了1999年LSH出现不找最近的找",
      "start": 339.771,
      "end": 346.763,
      "segment_index": 18
    },
    {
      "index": 64,
      "text": "差不多近的就行2017年Meta搞了",
      "start": 346.763,
      "end": 353.754,
      "segment_index": 18
    },
    {
      "index": 65,
      "text": "FAISS十亿级向量毫秒级搜索",
      "start": 353.754,
      "end": 359.58,
      "segment_index": 18
    },
    {
      "index": 66,
      "text": "你现在用ChatGPT问问题它去知识",
      "start": 359.88,
      "end": 364.776,
      "segment_index": 19
    },
    {
      "index": 67,
      "text": "库里找答案本质就是在embeddin",
      "start": 364.776,
      "end": 369.672,
      "segment_index": 19
    },
    {
      "index": 68,
      "text": "g空间做KNN搜索一九五一年那个蠢到",
      "start": 369.672,
      "end": 374.568,
      "segment_index": 19
    },
    {
      "index": 69,
      "text": "家的想法七十多年后变成了AI时代的基",
      "start": 374.568,
      "end": 379.464,
      "segment_index": 19
    },
    {
      "index": 70,
      "text": "础设施",
      "start": 379.464,
      "end": 380.28,
      "segment_index": 19
    },
    {
      "index": 71,
      "text": "下期讲LOF一个在KNN基础上进化出",
      "start": 380.58,
      "end": 386.889,
      "segment_index": 20
    },
    {
      "index": 72,
      "text": "来的异常检测算法让银行靠找邻居抓诈骗",
      "start": 386.889,
      "end": 393.197,
      "segment_index": 20
    },
    {
      "index": 73,
      "text": "犯关注不迷路",
      "start": 393.197,
      "end": 395.3,
      "segment_index": 20
    }
  ]
}