{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "paths": {
      "@blocks/*": ["../video-lego/src/blocks/*"],
      "@lego/*": ["../video-lego/src/lib/*"],
      "@data/*": ["../video-lego/src/data/*"],
      "@engine/*": ["./src/lib/engine/*"],
      "@layouts/*": ["./src/lib/layouts/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../video-lego/src/**/*.ts", "../video-lego/src/**/*.tsx", "../video-lego/data/**/*.ts"]
}
